# Settings for the ritm API. Lives in /etc/ritm/api.env (readable by root and the ritm user only).
# After editing: sudo systemctl restart ritm-api

# SQLite database file
RITM_DB=/var/lib/ritm/ritm.db

# Session cookie "Secure" flag: auto = only over HTTPS (recommended), 1 = always, 0 = never
RITM_COOKIE_SECURE=auto

# Telegram login (leave empty to hide the button). See DEPLOY.md, section Telegram.
RITM_TELEGRAM_BOT_TOKEN=
RITM_TELEGRAM_BOT_NAME=
